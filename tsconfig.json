{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@/app": [
        "frontend/src/app"
      ],
      "@/app/*": [
        "frontend/src/app/*"
      ],
      "@/client": [
        "frontend/src/client"
      ],
      "@/client/*": [
        "frontend/src/client/*"
      ],
      "@/gateway": [
        "frontend/src/gateway"
      ],
      "@/gateway/*": [
        "frontend/src/gateway/*"
      ],
      "@/subsystems": [
        "core/subsystems"
      ],
      "@/subsystems/*": [
        "core/subsystems/*"
      ],
      "@/shared": [
        "core/shared"
      ],
      "@/shared/*": [
        "core/shared/*"
      ],
      "@/contracts": [
        "core/contracts"
      ],
      "@/contracts/*": [
        "core/contracts/*"
      ],
      "@/demo": [
        "core/demo"
      ],
      "@/demo/*": [
        "core/demo/*"
      ]
    },
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [
    "frontend/src",
    "core",
    "backend"
  ]
}
